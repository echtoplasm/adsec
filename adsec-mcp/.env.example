# Copy to .env and fill in. .env is gitignored -- never commit credentials.

# Use the DC's FQDN, not its IP. Kerberos/LDAP service principals are
# registered against the hostname; an IP will fail SPN lookups.
AD_URL=ldap://DC1.lab.local:389
AD_BASE_DN=DC=lab,DC=local

# Dedicated read-only service account. NOT a domain admin.
AD_BIND_DN=CN=svc-mcp-reader,CN=Users,DC=lab,DC=local
AD_BIND_PW=

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Circuit breaker for the agent loop. Small models get stuck repeating
# the same tool call; this caps the damage.
MAX_STEPS=6
